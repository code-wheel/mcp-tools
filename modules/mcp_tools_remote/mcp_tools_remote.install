<?php

/**
 * @file
 * Install and requirements for MCP Tools Remote Server.
 */

declare(strict_types=1);

use Drupal\mcp_tools\Mcp\Sdk;

/**
 * Implements hook_requirements().
 */
function mcp_tools_remote_requirements(string $phase): array {
  $requirements = [];
  // Drupal 10 has the severities as constants only, Drupal 12 as an enum
  // only, and 11.2 and later have both.
  $enum = 'Drupal\Core\Extension\Requirement\RequirementSeverity';
  $error = enum_exists($enum) ? $enum::Error : REQUIREMENT_ERROR;
  $ok = enum_exists($enum) ? $enum::OK : REQUIREMENT_OK;

  if (in_array($phase, ['install', 'runtime'], TRUE)) {
    // This module can be installed in the same step as mcp_tools, for
    // example with "drush en mcp_tools mcp_tools_remote". The classes of
    // mcp_tools cannot be autoloaded then, so the one this check needs is
    // loaded from its file. 1.0.0-beta19 stopped here with "Class not found".
    if (!class_exists(Sdk::class)) {
      require_once __DIR__ . '/../../src/Mcp/Sdk.php';
    }
    if (Sdk::serverClass() === NULL) {
      $requirements['mcp_tools_remote_sdk'] = [
        'title' => t('MCP SDK (mcp/sdk)'),
        'value' => t('Missing'),
        'description' => t('The MCP Tools Remote Server module requires the Model Context Protocol PHP SDK. Run: <code>@command</code>.', ['@command' => Sdk::INSTALL_COMMAND]),
        'severity' => $error,
      ];
    }
  }

  // Runtime check for valid execution user.
  if ($phase === 'runtime') {
    $config = \Drupal::config('mcp_tools_remote.settings');
    $uid = (int) $config->get('uid');
    $enabled = (bool) $config->get('enabled');

    if ($enabled) {
      if ($uid === 0) {
        $requirements['mcp_tools_remote_uid'] = [
          'title' => t('MCP Tools Remote: Execution User'),
          'value' => t('Not configured'),
          'description' => t('The remote HTTP endpoint requires an execution user. Visit <a href=":url">Remote Settings</a> to configure.', [
            ':url' => '/admin/config/services/mcp-tools/remote',
          ]),
          'severity' => $error,
        ];
      }
      else {
        $user = \Drupal::entityTypeManager()->getStorage('user')->load($uid);
        if (!$user) {
          $requirements['mcp_tools_remote_uid'] = [
            'title' => t('MCP Tools Remote: Execution User'),
            'value' => t('User not found'),
            'description' => t('Configured user (uid @uid) does not exist. Visit <a href=":url">Remote Settings</a> to fix.', [
              '@uid' => $uid,
              ':url' => '/admin/config/services/mcp-tools/remote',
            ]),
            'severity' => $error,
          ];
        }
        else {
          $requirements['mcp_tools_remote_uid'] = [
            'title' => t('MCP Tools Remote: Execution User'),
            'value' => t('@name (uid @uid)', ['@name' => $user->getAccountName(), '@uid' => $uid]),
            'severity' => $ok,
          ];
        }
      }
    }
  }

  return $requirements;
}
