<?php

/**
 * @file
 * MCP Tools module - Read-only analysis tools for AI assistants.
 */

declare(strict_types=1);

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_tool_info_alter().
 *
 * MCP Tools results set only the outputs that apply and backfill the rest
 * with NULL, and the outputSchema they advertise allows null for every
 * output. Tool API 1.0.0-beta10 and later fail a result whose required
 * outputs are unset, so every MCP Tools output is declared optional here.
 * Values that are set are still validated against their type.
 */
function mcp_tools_tool_info_alter(array &$definitions): void {
  foreach ($definitions as $definition) {
    if (!is_object($definition) || !method_exists($definition, 'getOutputDefinitions') || !str_starts_with((string) $definition->getProvider(), 'mcp_tools')) {
      continue;
    }
    foreach ($definition->getOutputDefinitions() as $output) {
      $output->setRequired(FALSE);
    }
  }
}

/**
 * Implements hook_entity_presave().
 *
 * During a tool call, an entity is saved only if it passes Drupal's own
 * validation: the tools saved without it.
 */
function mcp_tools_entity_presave(EntityInterface $entity): void {
  // No tool call can run before its context exists: every other save on
  // the site stops here, without building a service.
  if (\Drupal::getContainer()->initialized('mcp_tools.tool_call_context')) {
    \Drupal::service('mcp_tools.save_guard')->check($entity);
  }
}

/**
 * Implements hook_help().
 */
function mcp_tools_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.mcp_tools':
      $output = '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('MCP Tools provides batteries-included tools for AI assistants working with Drupal sites via the Model Context Protocol (MCP).') . '</p>';
      $output .= '<h3>' . t('Tools of the base module (read only)') . '</h3>';
      $output .= '<dl>';
      $output .= '<dt>' . t('Site Health') . '</dt>';
      $output .= '<dd>' . t('mcp_tools_get_site_status, mcp_tools_get_system_status, mcp_tools_check_security_updates, mcp_tools_check_cron_status, mcp_tools_analyze_watchdog, mcp_tools_get_queue_status, mcp_tools_get_file_system_status') . '</dd>';
      $output .= '<dt>' . t('Content') . '</dt>';
      $output .= '<dd>' . t('mcp_tools_list_content_types, mcp_tools_get_recent_content, mcp_tools_search_content, mcp_tools_get_vocabularies, mcp_tools_get_terms, mcp_tools_get_files, mcp_tools_find_orphaned_files') . '</dd>';
      $output .= '<dt>' . t('Configuration') . '</dt>';
      $output .= '<dd>' . t('mcp_tools_get_config_status, mcp_tools_get_config, mcp_tools_list_config, mcp_list_text_formats, mcp_get_text_format') . '</dd>';
      $output .= '<dt>' . t('Users') . '</dt>';
      $output .= '<dd>' . t('mcp_tools_get_roles, mcp_tools_get_users, mcp_tools_get_permissions') . '</dd>';
      $output .= '<dt>' . t('Structure') . '</dt>';
      $output .= '<dd>' . t('mcp_tools_get_menus, mcp_tools_get_menu_tree') . '</dd>';
      $output .= '<dt>' . t('Discovery') . '</dt>';
      $output .= '<dd>' . t('mcp_tools_list_available') . '</dd>';
      $output .= '</dl>';
      $output .= '<h3>' . t('More tools') . '</h3>';
      $output .= '<p>' . t('The optional submodules add the tools that change a site, and more read tools. Enable the ones you need: content, structure, views, blocks, media and more.') . '</p>';
      return $output;
  }
}
